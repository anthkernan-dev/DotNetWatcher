<Application x:Class="DotNetWatcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DotNetWatcher"
             xmlns:tb="http://www.hardcodet.net/taskbar">
    <Application.Resources>
        <ContextMenu x:Key="TrayContextMenu">
            <MenuItem Header="Open" Click="TrayOpen_Click"/>
            <MenuItem Header="Refresh" Click="TrayRefresh_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="TrayExit_Click"/>
        </ContextMenu>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="Assets/app.ico"
                        ToolTipText="DotNetWatcher"
                        ContextMenu="{StaticResource TrayContextMenu}"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick"/>
    </Application.Resources>
</Application>
